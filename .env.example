# SafeClaw AI Assistant — Environment Variables
# Copy this file to .env and fill in all values before running `docker compose up`.
# Never commit .env to version control.
#
# Conventions:
#   __FILL_IN__   = paste a real value (see comment for where to get it)
#   __GENERATE__  = filled in for you by `scripts/init-secrets.sh` — do not set manually

# ─── Postgres: Observation DB ─────────────────────────────────────────────
# Holds the user's brain (observations, entities, style samples, embeddings).
POSTGRES_OBS_USER=obs_user
POSTGRES_OBS_PASSWORD=__GENERATE__
POSTGRES_OBS_DB=safeclaw_obs

# ─── Postgres: Task DB ────────────────────────────────────────────────────
# Holds task / queue state for the agent — kept in a separate cluster so a
# brain-side bug cannot read task credentials and vice-versa.
POSTGRES_TASKS_USER=tasks_super
POSTGRES_TASKS_PASSWORD=__GENERATE__
POSTGRES_TASKS_DB=safeclaw_tasks
TASKS_AGENT_PASSWORD=__GENERATE__
TASKS_HUMAN_PASSWORD=__GENERATE__

# ─── PostgREST / JWT ──────────────────────────────────────────────────────
# 256-bit random hex secret used by PostgREST to verify agent JWTs.
JWT_SECRET=__GENERATE__
# Pre-signed JWT for the hermes-actor tasks_api MCP tool.
# Payload: {"role":"tasks_agent"}; signed with JWT_SECRET (HS256).
TASKS_AGENT_JWT=__GENERATE__

# ─── Hermes Agent LLM Backend (Ollama Cloud via local daemon) ────────────
# Hermes uses these to know which provider/endpoint/model to call.
# Default points at a local Ollama daemon which proxies :cloud models to
# ollama.com — override to gpt-4o, claude-sonnet-*, etc. as needed.
HERMES_INFERENCE_PROVIDER=ollama-cloud
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama-local
HERMES_DEFAULT_MODEL=glm-5.1:cloud

# ─── Composio (OAuth + MCP integrations) ─────────────────────────────────
# Run `composio dev init` in the SafeClaw install dir, or grab these from the
# Composio dashboard at https://app.composio.dev.
COMPOSIO_API_KEY=__FILL_IN__
COMPOSIO_USER_ID=__FILL_IN__
# Reader-tier MCP server URL — only `read` actions allowed (e.g. GMAIL_FETCH_EMAILS).
# This is the boundary that prevents the Reader from sending anything.
COMPOSIO_READER_MCP_URL=__FILL_IN__
# Actor-tier MCP server URL — `draft`/`send` actions allowed but no raw inbox reads.
COMPOSIO_ACTOR_MCP_URL=__FILL_IN__

# ─── Web research (optional but recommended) ─────────────────────────────
# Hermes has built-in `web_search` + `web_extract` skills that auto-activate
# when one of these provider keys is set. Pick whichever provider you prefer —
# Firecrawl is the default we recommend. Don't fill multiple unless you want
# Hermes to choose between them at runtime.
#
# Firecrawl: URL → clean markdown + web search. Sign up at
# https://www.firecrawl.dev/signin?view=signup — 500 free pages one-time, then
# $29/mo Hobby plan for 3k pages/mo. No card required for free tier.
FIRECRAWL_API_KEY=__FILL_IN__
# Optional alternates (any one is enough):
# EXA_API_KEY=__FILL_IN__         # https://exa.ai/  — AI-native search + content
# TAVILY_API_KEY=__FILL_IN__      # https://app.tavily.com/  — search + extract + crawl
# PARALLEL_API_KEY=__FILL_IN__    # https://parallel.ai/  — search + extract

# ─── Slack (v2 control surface + cron delivery) ───────────────────────────
# Create a Slack app at https://api.slack.com/apps, enable Socket Mode, and
# install it to your workspace. Copy the Bot User OAuth Token and App-Level
# Token (starts with xapp-). The home channel is where cron results and
# proactive messages appear (DM @safeclaw to find channel IDs).
SLACK_BOT_TOKEN=__FILL_IN__
SLACK_APP_TOKEN=__FILL_IN__
SLACK_HOME_CHANNEL=__FILL_IN__
# Comma-separated list of channel IDs to summarize daily (e.g. team channels).
# Leave empty to skip the daily digest cron job.
SLACK_INGEST_CHANNELS=__FILL_IN__

# ─── Telegram (v1 control surface) ───────────────────────────────────────
# Create a bot via @BotFather on Telegram → copy the token. Add your numeric
# Telegram user ID(s) to TELEGRAM_ALLOWED_USERS as a comma-separated list
# (DM @userinfobot to find your numeric ID).
TELEGRAM_BOT_TOKEN=__FILL_IN__
TELEGRAM_ALLOWED_USERS=__FILL_IN__

# ─── Brain layer ─────────────────────────────────────────────────────────
# Single-user installs use 'primary'. Sentence-transformers model must be
# 384-dim to match the pgvector schema.
BRAIN_USER_KEY=primary
BRAIN_EMBEDDING_MODEL=all-MiniLM-L6-v2
BRAIN_EMBEDDER_URL=http://embedder:8000
BRAIN_OBS_DATABASE_URL=postgresql://${POSTGRES_OBS_USER}:${POSTGRES_OBS_PASSWORD}@postgres-obs:5432/${POSTGRES_OBS_DB}

# ─── Feature flags ───────────────────────────────────────────────────────
# v1 ships actor-on by default — drafts only, never auto-send.
ACTOR_ENABLED=true
# Phase 4 unlock — never enable until the 30-day clean run is complete.
AUTO_SEND_ENABLED=false
# How far back bootstrap-brain.sh scrapes Gmail on a fresh install.
BOOTSTRAP_DAYS=90
