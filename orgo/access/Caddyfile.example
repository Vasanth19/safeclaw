# SafeClaw on orgo — authenticating front door for the dashboard + setup.
#
# orgo does NOT expose app ports to a public URL (verified against their docs).
# So we run a cloudflared named tunnel → this Caddy → the LOOPBACK dashboard.
# Caddy is the security gate: nothing reaches :9119 without basic-auth.
#
# TLS is terminated at the Cloudflare edge; Caddy speaks plain HTTP on :8443
# (cloudflared connects to it over localhost), so auto_https is off.
#
# Render: envsubst < orgo/access/Caddyfile.example > /etc/caddy/Caddyfile
#         (DASHBOARD_AUTH_USER / DASHBOARD_AUTH_PASSWORD_HASH come from client.env)

{
	auto_https off
	admin off
}

:8443 {
	# bcrypt hash — generate with:  caddy hash-password --plaintext '<pw>'
	basic_auth {
		{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_PASSWORD_HASH}
	}

	# Single origin = the Hermes dashboard (UI + plugin APIs + chat + the
	# safeclaw-setup plugin tab). No path conflicts, no second web app.
	reverse_proxy 127.0.0.1:9119 {
		header_up X-Forwarded-Proto https
	}

	encode gzip
	log {
		output file /var/log/caddy/safeclaw-access.log
	}
}
