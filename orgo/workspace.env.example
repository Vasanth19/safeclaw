# ═══════════════════════════════════════════════════════════════════
# workspace.env.example — per-workspace credential template (orgo-native)
#
# HOW TO USE:
#   1. Copy to <client>-agent.env at the repo root:  cp orgo/workspace.env.example mark-agent.env
#   2. Fill in every __FILL_IN__ (sources noted per section)
#   3. chmod 600 <client>-agent.env
#   4. The file is auto-gitignored (*.env rule) — it NEVER commits.
#      Back up the filled file to brain-personal (GBrain): projects/safeclaw/<client>-credentials
#
# This mirrors the placeholders used by orgo/ORGO-CLIENT-TEMPLATE.md Steps 0-12.
# ═══════════════════════════════════════════════════════════════════

# ── orgo (Step 0) ────────────────────────────────────────────────────
# Key: orgo.ai dashboard → Settings → API Keys (must be the PAID workspace owner's key)
ORGO_API_KEY=__FILL_IN__
# Workspace + computer: GET https://www.orgo.ai/api/workspaces (or the orgo dashboard)
ORGO_WORKSPACE_ID=__FILL_IN__
CID=__FILL_IN__
# Short client slug — becomes the hostname: safeclaw-<CLIENT>.growthsystems.ai
CLIENT=__FILL_IN__

# ── LLM: Ollama Cloud (Steps 1, 3) ───────────────────────────────────
# Two keys = the credential pool (auto-failover on 429). Both from ollama.com → Settings → API Keys.
OLLAMA_API_KEY=__FILL_IN__
OLLAMA_FALLBACK_KEY=__FILL_IN__
# glm-4.7, NOT kimi-k2.5 (see .claude/knowledge/gotchas/ollama-cloud-models-and-limits.md)
HERMES_DEFAULT_MODEL=glm-4.7

# ── Embeddings (Step 2 — REQUIRED for dreaming) ──────────────────────
# Pick ONE. Ollama Cloud has NO embeddings endpoint — these are the only options.
#   OpenRouter: openrouter.ai/keys → embedding_model=openrouter:openai/text-embedding-3-small
#   OpenAI:     platform.openai.com → embedding_model=openai:text-embedding-3-small
OPENROUTER_API_KEY=__FILL_IN__
OPENAI_API_KEY=__FILL_IN__

# ── SafeClaw Console basic-auth (Step 6) ─────────────────────────────
SAFECLAW_UI_USER=__FILL_IN__            # usually = CLIENT
UI_PASSWORD=__GENERATE__                # openssl rand -base64 18 | tr -d '/+=' | head -c 20

# ── Composio Gmail trust split (Step 11) ─────────────────────────────
# Key: app.composio.dev → Settings → API Keys
# user_id is the pg-test-… string on the connected account (NOT the dashboard label)
COMPOSIO_API_KEY=__FILL_IN__
COMPOSIO_USER_ID=__FILL_IN__
CONNECTED_ACCOUNT_ID=__FILL_IN__
# MCP server base URLs — created by Console /api/gmail/wire, or GET /api/v3/mcp/servers
READER_MCP_BASE_URL=__FILL_IN__
ACTOR_MCP_BASE_URL=__FILL_IN__

# ── Telegram (Step 10) ───────────────────────────────────────────────
# DEDICATED bot per box (@BotFather → /newbot). NEVER share a bot across boxes —
# Telegram allows exactly one getUpdates consumer.
TELEGRAM_BOT_TOKEN=__FILL_IN__
# Numeric ID (from @userinfobot) — NOT a Slack U… id
TELEGRAM_ALLOWED_USERS=__FILL_IN__

# ── Slack (Step 12) ──────────────────────────────────────────────────
# Client follows docs/SLACK-APP-WALKTHROUGH.md in THEIR workspace (~10 min)
SLACK_BOT_TOKEN=__FILL_IN__             # xoxb-…
SLACK_APP_TOKEN=__FILL_IN__             # xapp-1-…
SLACK_WORKSPACE_ID=__FILL_IN__          # T…
SLACK_USER_ID=__FILL_IN__               # U…

# ── Optional extras ──────────────────────────────────────────────────
FIRECRAWL_API_KEY=__FILL_IN__
