# syntax=docker/dockerfile:1.6
#
# Dockerfile.safeclaw-hermes — SafeClaw distribution image for Hermes.
#
# This Dockerfile re-runs the upstream Hermes Dockerfile inline, then layers
# SafeClaw modifications on top:
#   1. Skill prune via prune-skills.sh (runs at build time).
#   2. Replace ENTRYPOINT with safeclaw-entrypoint.sh (wraps upstream).
#   3. Bake safeclaw-default-config.yaml into /opt/hermes/.
#
# Build context: the SafeClaw repo root (so we can reach BOTH ./vendor/hermes-agent
# and ./docker/ from a single context).
#
# Build command (use scripts/build-images.sh — don't run by hand):
#   docker build \
#     -t safeclaw/hermes:1.0 \
#     -f docker/Dockerfile.safeclaw-hermes \
#     .

# ─── Stage A: rebuild the upstream Hermes image inline ─────────────────────
# We can't FROM a published hermes-agent:base because the upstream repo has no
# such tag — `docker build .` from the hermes repo is the upstream's only flow.
# Replicate it here so SafeClaw is one source of truth.
FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM tianon/gosu:1.19-trixie@sha256:3b176695959c71e123eb390d427efc665eeb561b1540e82679c15e992006b8b9 AS gosu_source

FROM debian:13.4 AS hermes_base

ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# tini reaps zombie MCP stdio subprocesses; python3-yaml lets the safeclaw
# entrypoint patch config.yaml without bootstrapping the venv first.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential nodejs npm python3 python3-yaml ripgrep ffmpeg gcc \
        python3-dev libffi-dev procps git openssh-client docker-cli tini && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes

COPY --chmod=0755 --from=gosu_source /gosu /usr/local/bin/
COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

WORKDIR /opt/hermes

# ── Layer-cached node deps ──────────────────────────────────────────────────
# Copy only the package manifests first so npm install + Playwright stay
# cached unless a lockfile actually changes.
COPY vendor/hermes-agent/package.json vendor/hermes-agent/package-lock.json ./
COPY vendor/hermes-agent/web/package.json vendor/hermes-agent/web/package-lock.json web/

RUN npm install --prefer-offline --no-audit && \
    npx playwright install --with-deps chromium --only-shell && \
    (cd web && npm install --prefer-offline --no-audit) && \
    npm cache clean --force && \
    # Expose agent-browser CLI on PATH (installed via package.json, but node_modules/.bin
    # is not in the container's default PATH so shutil.which misses it).
    ln -sf /opt/hermes/node_modules/.bin/agent-browser /usr/local/bin/agent-browser

# ── Source ──────────────────────────────────────────────────────────────────
# Pull the entire hermes-agent tree into /opt/hermes. The .dockerignore at
# repo root excludes node_modules so the installs above survive.
COPY --chown=hermes:hermes vendor/hermes-agent/ .

# Build web dashboard (Vite outputs to hermes_cli/web_dist/).
RUN cd web && npm run build

# Permissions
USER root
RUN chmod -R a+rX /opt/hermes

# Python venv with all extras (matches upstream Dockerfile).
RUN uv venv && \
    uv pip install --no-cache-dir -e ".[all]"

# Pre-install Chrome for agent-browser as the hermes user so browser_tool.py
# can navigate without an explicit --executable-path. Runs as hermes (uid 10000)
# so the cache lands in /opt/data/.agent-browser/browsers at runtime.
USER hermes
RUN HOME=/opt/data agent-browser install
USER root

# ─── Stage B: SafeClaw layer ────────────────────────────────────────────────
# Skill prune. Layer is cache-invalidated only when the prune script itself
# (or the underlying skills tree) changes.
COPY --chmod=0755 docker/prune-skills.sh /usr/local/bin/prune-skills.sh
RUN /usr/local/bin/prune-skills.sh /opt/hermes/skills

# SafeClaw entrypoint + baked default config. Paths match what the entrypoint
# references at runtime.
COPY docker/safeclaw-default-config.yaml /opt/hermes/safeclaw-default-config.yaml
COPY --chmod=0755 docker/safeclaw-entrypoint.sh /opt/hermes/docker/safeclaw-entrypoint.sh

# Make the operator template mount target exist as a directory by default.
RUN mkdir -p /safeclaw/config-template && \
    chown -R hermes:hermes /safeclaw

# ─── Stage B (cont): bake brain-api + tasks-api + slack-api + drive-api MCPs ─
# Previously these were sidecar containers invoked via `docker exec`. Baking
# the source into the Hermes image lets Hermes spawn them as direct Node /
# Python subprocesses (standard stdio MCP pattern) — drops 4 containers,
# removes the docker.sock dependency for these MCPs, and means one image to ship.
#
# Two-step COPY (manifests → install → src → build) so npm install stays
# layer-cached unless package.json/package-lock.json actually changes.
COPY mcp-tools/brain-api/package.json mcp-tools/brain-api/package-lock.json /opt/mcp-tools/brain-api/
RUN cd /opt/mcp-tools/brain-api && npm install --no-audit --prefer-offline
COPY mcp-tools/brain-api/tsconfig.json /opt/mcp-tools/brain-api/
COPY mcp-tools/brain-api/src/ /opt/mcp-tools/brain-api/src/
RUN cd /opt/mcp-tools/brain-api && npm run build && npm prune --omit=dev

COPY mcp-tools/tasks-api/package.json mcp-tools/tasks-api/package-lock.json /opt/mcp-tools/tasks-api/
RUN cd /opt/mcp-tools/tasks-api && npm install --no-audit --prefer-offline
COPY mcp-tools/tasks-api/tsconfig.json /opt/mcp-tools/tasks-api/
COPY mcp-tools/tasks-api/src/ /opt/mcp-tools/tasks-api/src/
RUN cd /opt/mcp-tools/tasks-api && npm run build && npm prune --omit=dev

# slack-api: native Slack MCP (channel history, list, send) — distinct from
# Composio's SLACK_SEND_MESSAGE; the native tools expose lower-level ops the
# reader's intake protocol depends on (slack_get_channel_history, slack_list_channels).
COPY mcp-tools/slack-api/package.json /opt/mcp-tools/slack-api/
RUN cd /opt/mcp-tools/slack-api && npm install --no-audit --prefer-offline
COPY mcp-tools/slack-api/tsconfig.json /opt/mcp-tools/slack-api/
COPY mcp-tools/slack-api/src/ /opt/mcp-tools/slack-api/src/
RUN cd /opt/mcp-tools/slack-api && npm run build && npm prune --omit=dev

# drive-api: service-account Google Drive uploads (Python). Isolated venv at
# /opt/mcp-tools/drive-api/.venv so its deps don't bleed into the Hermes venv.
COPY mcp-tools/drive-api/requirements.txt /opt/mcp-tools/drive-api/
RUN uv venv /opt/mcp-tools/drive-api/.venv && \
    uv pip install --python /opt/mcp-tools/drive-api/.venv/bin/python --no-cache-dir \
        -r /opt/mcp-tools/drive-api/requirements.txt
COPY mcp-tools/drive-api/main.py /opt/mcp-tools/drive-api/

# Final perms — any HERMES_UID needs traverse + read on our additions.
RUN chmod -R a+rX /opt/hermes /safeclaw /opt/mcp-tools

ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"

# Sentinel env vars so customers / scripts can detect the SafeClaw-modified image.
ENV SAFECLAW_IMAGE_VARIANT=hermes
ENV SAFECLAW_IMAGE_VERSION=1.2

VOLUME [ "/opt/data" ]
ENTRYPOINT [ "/usr/bin/tini", "-g", "--", "/opt/hermes/docker/safeclaw-entrypoint.sh" ]
