# SafeClaw on orgo.ai — per-client environment template.
#
# Copy to client.env, fill __FILL_IN__, let provision-client.py fill the rest.
# NEVER commit client.env (it's gitignored). One file per client.
#
#   __GENERATE__ → filled by scripts/init-secrets.sh (random secrets)
#   __FILL_IN__  → operator/customer pastes a real value
#   __MINTED__   → filled after boot (gbrain auth create / Composio account ids)

# ── Client identity ──────────────────────────────────────────────────────────
CLIENT_NAME=__FILL_IN__                 # short slug, e.g. "suffolk" (orgo workspace = client-<name>)

# ── Brain Postgres (generated) ───────────────────────────────────────────────
BRAIN_DB_USER=safeclaw_brain
BRAIN_DB_PASSWORD=__GENERATE__
BRAIN_DB_NAME=safeclaw_brain

# ── GBrain engine ────────────────────────────────────────────────────────────
GBRAIN_VERSION=0.37.11.0
SAFECLAW_BRAIN_HTTP_URL=http://127.0.0.1:3131
SAFECLAW_BRAIN_READER_TOKEN=__MINTED__  # gbrain auth create reader
SAFECLAW_BRAIN_ACTOR_TOKEN=__MINTED__   # gbrain auth create actor
# Embeddings endpoint (OpenAI-compatible). Default = host Ollama (nomic-embed-text).
# To use a hosted embeddings provider instead, set this URL — but FIRST verify the
# GBrain image honors an API-keyed embeddings endpoint (see ORGO-DEPLOY.md).
BRAIN_EMBEDDINGS_URL=http://host.docker.internal:11434/v1

# ── LLM (hosted — keeps the orgo box light) ──────────────────────────────────
OLLAMA_API_KEY=__FILL_IN__              # Ollama Cloud key, or swap provider in hermes config
HERMES_DEFAULT_MODEL=kimi-k2.5

# ── Composio (OAuth + MCP for Gmail/Slack) ───────────────────────────────────
COMPOSIO_API_KEY=__FILL_IN__
COMPOSIO_USER_ID=__FILL_IN__
COMPOSIO_READER_MCP_URL=__FILL_IN__     # read-only toolkit (reader Gmail)
COMPOSIO_ACTOR_MCP_URL=__FILL_IN__      # draft toolkit (actor Gmail)
# Per-Gmail-account ids are appended by render-hermes-config.py from the
# Connections registry, e.g. GMAIL_SUFFOLK_ACCOUNT_ID / GMAIL_HYPHENLABS_ACCOUNT_ID.

# ── Slack (socket mode — no public URL) ──────────────────────────────────────
SLACK_BOT_TOKEN=__FILL_IN__             # xoxb-…  (actor: send/post)
SLACK_MCP_BOT_TOKEN=__FILL_IN__         # xoxb-…  (reader MCP, read-only)
SLACK_HOME_CHANNEL=__FILL_IN__
SLACK_INGEST_CHANNELS=__FILL_IN__

# ── Telegram (long-polling — no public URL) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=__FILL_IN__          # from @BotFather
TELEGRAM_ALLOWED_USERS=__FILL_IN__      # comma-separated numeric ids

# ── Web research (optional) ──────────────────────────────────────────────────
FIRECRAWL_API_KEY=__FILL_IN__

# ── Public access (cloudflared tunnel + authenticated Caddy gate) ────────────
# orgo can't expose app ports publicly, so each client gets a stable URL via a
# cloudflared named tunnel → Caddy (basic-auth) → loopback dashboard.
PUBLIC_HOSTNAME=__FILL_IN__             # e.g. safeclaw-acme.yourdomain.com
CLOUDFLARE_TUNNEL_TOKEN=__FILL_IN__     # from `cloudflared tunnel create` (token mode)
CLOUDFLARE_TUNNEL_ID=__FILL_IN__        # only if using config-file mode instead of token
DASHBOARD_AUTH_USER=__FILL_IN__         # login for the public dashboard/setup
DASHBOARD_AUTH_PASSWORD_HASH=__FILL_IN__ # bcrypt — `caddy hash-password --plaintext '<pw>'`

# ── Safety defaults (client-facing: keep these) ──────────────────────────────
AUTO_SEND_ENABLED=false                 # draft-only until an explicit per-client opt-in
BOOTSTRAP_DAYS=90
