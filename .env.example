# SafeClaw AI Assistant — Environment Variables
# Copy this file to .env and fill in all values before running docker compose up.
# Never commit .env to version control.

# ─── Postgres: Observation DB ─────────────────────────────────────────────────
POSTGRES_OBS_USER=obs_user
POSTGRES_OBS_PASSWORD=change_me_obs_password_here
POSTGRES_OBS_DB=safeclaw_obs

# ─── Postgres: Task DB ────────────────────────────────────────────────────────
POSTGRES_TASKS_USER=tasks_super
POSTGRES_TASKS_PASSWORD=change_me_tasks_password_here
POSTGRES_TASKS_DB=safeclaw_tasks

# Application-level task DB users (created by 002_task_schema.sql)
TASKS_AGENT_PASSWORD=change_me_agent_password_here
TASKS_HUMAN_PASSWORD=change_me_human_password_here

# ─── Nango OAuth Vault ────────────────────────────────────────────────────────
# 32-byte random hex: openssl rand -hex 32
NANGO_ENCRYPTION_KEY=change_me_32_byte_hex_key_here_0000000000000000000000000000000000
# Nango secret key (set in Nango dashboard after first boot)
NANGO_SECRET_KEY=change_me_nango_secret_key

# Nango uses postgres-tasks container with a dedicated DB
NANGO_DB_HOST=postgres-tasks
NANGO_DB_PORT=5432
NANGO_DB_USER=tasks_super
NANGO_DB_PASSWORD=${POSTGRES_TASKS_PASSWORD}
NANGO_DB_NAME=nango

# ─── PostgREST / JWT ──────────────────────────────────────────────────────────
# 256-bit random secret: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_here_at_least_32_chars_long_random_hex

# Pre-signed JWT for the hermes-actor tasks_api tool (role=tasks_agent, no expiry or long expiry)
# Generate with: node -e "const jwt=require('jsonwebtoken'); console.log(jwt.sign({role:'tasks_agent'},process.env.JWT_SECRET))"
TASKS_AGENT_JWT=change_me_tasks_agent_jwt_token

# ─── Google / Gmail / Drive ──────────────────────────────────────────────────
# OAuth credentials are managed by Nango — set client ID/secret in Nango dashboard.
# These placeholders are referenced in nango.yaml.
GOOGLE_CLIENT_ID=change_me_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me_google_oauth_client_secret

# rclone: Google Drive folder ID for the client's monitored Drive folder
RCLONE_DRIVE_FOLDER_ID=change_me_google_drive_folder_id

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-change-me-slack-bot-token
SLACK_APP_TOKEN=xapp-change-me-slack-app-level-token
# Channel ID for the #safeclaw-review approval channel
SLACK_REVIEW_CHANNEL_ID=change_me_slack_channel_id

# ─── Hermes Agent ─────────────────────────────────────────────────────────────
# LLM provider API key for Hermes (OpenAI-compatible endpoint)
HERMES_LLM_API_KEY=change_me_llm_api_key
HERMES_LLM_BASE_URL=https://api.openai.com/v1
HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Phase 1: reader only. Set ACTOR_ENABLED=true in Phase 2.
ACTOR_ENABLED=false
# Phase 4 prerequisite: 30-day clean run required. Default off.
AUTO_SEND_ENABLED=false

# ─── SafeClaw Brain ───────────────────────────────────────────────────────────
# Which profile 'slot' to use. 'primary' is fine for a single-user install.
BRAIN_USER_KEY=primary
# Sentence-transformers model. Must be 384-dim to match pgvector schema.
BRAIN_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Internal URL the brain-api uses to reach the embedder for query vectors.
BRAIN_EMBEDDER_URL=http://embedder:8000
# Brain writes to the observation DB (co-located with observations + embeddings).
BRAIN_OBS_DATABASE_URL=postgresql://${POSTGRES_OBS_USER}:${POSTGRES_OBS_PASSWORD}@postgres-obs:5432/${POSTGRES_OBS_DB}
